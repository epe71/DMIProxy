#### Test File Rules ####
# Apply these rules to all test files (*Tests.cs, *Test.cs, TestHelper.cs, etc.)

[*Tests.cs]

# Allow var when type is apparent (cleaner test code)
csharp_style_var_when_type_is_apparent = true
csharp_style_var_for_built_in_types = true
csharp_style_var_elsewhere = true

# Allow more concise code in tests
csharp_style_expression_bodied_methods = true
csharp_style_expression_bodied_properties = true

# Less strict about unused parameters in test helpers
dotnet_diagnostic.IDE0060.severity = suggestion

# Allow multiple statements on same line in simple test assertions
csharp_style_allow_embedded_statements_on_same_line_experimental = true

# Suppress insecure random warning (OK for test data, not cryptographic)
dotnet_diagnostic.CA5394.severity = silent


#### Benchmark File Rules ####
# Apply to benchmark files (*Benchmark.cs, BenchmarkSuite*.cs, etc.)

[*Benchmark.cs]
[BenchmarkSuite*/*]

# Suppress insecure random warning (OK for benchmark data, not cryptographic)
dotnet_diagnostic.CA5394.severity = silent

# More permissive var usage in benchmarks
csharp_style_var_when_type_is_apparent = true
csharp_style_var_for_built_in_types = true
csharp_style_var_elsewhere = true

# Allow concise benchmark code
csharp_style_expression_bodied_methods = true
csharp_style_expression_bodied_properties = true

